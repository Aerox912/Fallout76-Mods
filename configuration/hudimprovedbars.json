  //==========================================================================================================================
  // GENERAL SETTINGS
  //==========================================================================================================================
  "features": [
    {
      // IHB language
      // Available values: "en" - English, "pl" - Polish, "de" - German, "fr" - French, "it" - Italian, "es" - Spanish, "ru" - Russian, "zh" - Chinese
      // Sets the language for the mod. Does not affect game language.
      // Need more languages? Contact me on Nexus Mods or Discord
      "language": "en",
      // Global scale factor for all HUD elements. 1.0 is default size.  [Range: 0.1 - 10]
      // Use this setting to globally scale all HUD elements added by this mod.
      // If you want to scale individual elements, you can do that in the "widgets" section, by adding the "scaleFactor" for desired widget. 
      //  This setting will scale all elements, including those that don't have individual scale settings.
      "scaleFactor": 0.8,
      // Keybindings for mod components. [Available values: any valid key code]
      "keybindings": {
        "manageTeam": 112, // F1 key
        "settings": 121 // F10 key
      },
      // This section defines the positions and scale factors for the vanilla HUD elements.
    "vanillaHudElements": {
        "hpMeter": {
          "x": 0,
          "y": 0,
          "scaleFactor": 1,
          "showLabel": true
        },
        "apMeter": {
          "x": 0,
          "y": 0,
          "scaleFactor": 1,
          "showLabel": true
        },
        "compass": {
          "x": 0,
          "y": 0,
          "scaleFactor": 1
        },
        "questTracker": {
          "x": 0,
          "y": 0,
          "scaleFactor": 1
        }
      },
      // Should we automatically realign elements under the HP bar? [Available values: true/false]
      // This is needed for the widgets under the HP bar, such as weight, currencies, cores, clock, 
      // because they have different widths, and if you have more than one of them enabled, they will overlap each other.
      // DISABLE this if you have custom positions for these elements
      // When enabled, it will automatically align these elements to the left, on the X axis
      "autoAlignLeftGroup": false,
      // By default, the bars disappear after a short time when they reach [value] => [thirstBarsPercentIndefiniteShow]%. 
      // This can be useful for players who want to keep an eye on their hunger and thirst levels without worrying about the bars disappearing.
      // For example, if you set this to 50, the bars will stay visible until your hunger or thirst increases above 50%. 
      // Setting this to 100 makes it stay forever.  [Default game value: 20 Maximum value: 100]
      "thirstBarsPercentIndefiniteShow": 100,
      // Whether to show hunger and thirst icons next to the bars. [Available values: true/false]
      "showHungerThirstIcons": true,
      // Debug stuff
      // This section is for debugging purposes. It allows you to enable debug mode, which will show additional information and messages in the console. 
      // You can also enable messages for mod initialization and config reload events. 
      // This can be useful for troubleshooting issues with the mod or for development purposes. [Available values: true/false]
      // ShowDebug is not yet implemented. It will be implemented in the future, but for now, it does nothing.
      "debugSettings": {
        // Enable debug mode. do not use this
        "showDebug": false,
        // Show a message when mod is initialized
        "showModInitializationMessage": true,
        // Show a message when config is reloaded
        "showConfigReloadMessage": true
      },
      //This subsection defines specific widget settings, as well as the on-screen coordinates for the HUD elements. All positions are relative to the parent containers. Change it only if you have to.
      // You can set the scale of each widget elements, if you do not like their default sizes. 
      "widgets": [
        {
          // The quest tracker widget. This widget shows the current quest objectives and their progress.
          "questtracker":
          {
            "enabled": false,
            "showBackground": true,
            "showObjectives": true,
            "showTimers": true,
            "showProgress": true,
            "x": 820,
            "y": 180,
            "scaleFactor": 1
          },
          "teammates": {
            "enabled": true,
            // Whether to show the local player in the teammates widget. [Available values: true/false]
            "showLocalPlayer": false,

            "bottomToTop": false,
            "showBackground": false,
            "showTeamName": true,
            "showBonus": true,

            "showPlayerIcons": true,
            "showAvatarFrames": true,
            "showAccents": true,

            "showNames": true,
            "showTitles": true,
            "showLevels": true,
            "showStatus": true,

            "showHealthBar": true,
            "showRadsBar": true,
            "showGlowBar": true,
            "showBarSegments": true,
            "showSeparators": false,

            "showHealthPercentage": true,
            "showRadsPercentage": true,
            "showGlowPercentage": true,

            "x": 5,
            "y": 670,
            "scaleFactor": 1
          },
          // The target meter widget. This widget shows the name, level, and health of the currently targeted enemy or NPC. 
          "targetmeter": {
            "enabled": false,
            "showStealthMeter": true,
            "x": 0,
            "y": 58,
            "scaleFactor": 1
          },
          // The active effects widget. This widget shows all active effects on the player, including their remaining duration.
          "activeeffects": {
            "enabled": true,
            // Whether to show only timed effects in the active effects widget. [Available values: true/false]
            "showTimedOnly": true,
            // Whether to show only main effect names in the active effects widget. [Available values: true/false]
            "showMainEffectNamesOnly": false,
            // Filter out effects that you don't want to see in the active effects widget. You can add more effects to this list, but make sure to use the exact name of the effect as it appears in the game.
            "excludedEffects": [],
            // Filter out effects that you want to be reminded of when they are about to expire. You can add more effects to this list, but make sure to use the exact name of the effect as it appears in the game.
            "listRemindExpiringEffects": [
              "Accuracy Boost",
              "*C[1](CW+) Smoked Mirelurk Fillets",
              "*C[1](XP+) Tasty Squirrel Stew",
              "Wisdom of the Mothman",
              "*C[1](DR+) Mirelurk Jerky",
              "*C[2](END) Pemmican",
              "*H[1](APR) Company Tea",
              "Serum: Adrenal Reaction",
              "Serum: Bird Bones",
              "Serum: Carnivore",
              "Serum: Eagle Eyes",
              "Serum: Egg Head",
              "Serum: Grounded",
              "Serum: Herd Mentality",
              "Serum: Marsupial",
              "Serum: Scaly Skin",
              "Serum: Speed Demon",
              "Serum: Unstable Isotope",
              "*C[2](AP+) Cooked Softshell Meat",
              " · Berry Mentats"
            ],
            // The duration in seconds before an effect expires that will trigger a reminder. Set to 0 to disable reminders. [Range: 0 - 3600]
            "remindExpiringEffectsDurationSeconds": 90,
            "x": -170,
            "y": -1045,
            "scaleFactor": 0.7
          },
          // Pickup history widget shows the last picked up item and the total number of items picked up. It can also show the last picked up item count.
          "pickuphistory": {
            "enabled": false,
            "x": -90,
            "y": -830,
            "scaleFactor": 1,
            "alwaysVisible": false,
            "format": "({pickedUpCount}) {pickedUpText} | {lastPickedUpItemName} ({lastPickedUpItemCount})",
            "ignoreList": []
          },

          // Whether to show the list of players in the current server. [Available values: true/false]
          "playerslist": {
            "enabled": false,
            "showTitles": true,
            "showNearestMapMarker": true,
            "x": -90,
            "y": -120
