            "x": -10,
            "y": -35,
            "scale": 1
          },
          "currencies": {
            //Whether to show the number of bottle caps and optionally other currencies specified in 'showonly' setting. [Available values: true/false]
            "enabled": true,
            // Which currencies to show, separated by ';' [Available values "caps", "bullion", "scrips", "stamps", "tadpole", "possum", "perks"]
            // You can change the order of currencies too. Type your desired order separated by ';'
            "showOnly": "caps;bullion;stamps;scrips;perks;tadpole;possum",
            // Should the icons be colored or mono?  [Available values: true/false]  
            "coloredIcons": true,
            // POSITIONING
            // Whether to show icons vertically or hortizonally [Available values: true/false]
            // autoAlignLeftGroup is disabled for this widget if this feature is enabled. Will mess up things, unless you move each item individually.
            "vertical": false,
            "x": -5,
            "y": -130,
            "scale": 1
          },
          "cores": {
            // Whether to display the number of fusion cores. [Available values: true/false]
            "enabled": true,
            // POSITIONING
            "x": 65,
            "y": -35
          },
          "clock": {
            // Displays a clock.
            // If you see the "not synced" message — open your Pip-Boy radio to sync the time.
            // If you're still seeing this message after opening pipboy's radio a few times - it means another mod is conflicting with this feature.
            // It will desync if you minimize the game.
            "enabled": true,
            // Which clock to show, separated by ';'.  [Available values "server" - server time, "local" - local time. Default is Server]
            "mode": "server;local",
            // Whether to show your local time next to the server time.
            "use24hFormat": true,
            // POSITIONING
            "x": 150,
            "y": -35,
            "scale": 1
          },
          "weaponcond": {
            //Whether to show the condition of the currently equipped weapon. [Available values: true/false]
            "enabled": true,
            // You can enable weapon name display. If you disable this setting, you'll only see a percentage indicator, e.g., (12.5%). 
            "showNames": true,
            // By default, with weapon name display enabled, the widget shows the full name. You can use shortened names to display only the weapon name itself, without legendaries.
            // It works only in some languages for now. Not in english.
            "shortenNames": false,
            // Toggles visibility of the weapon icon
            "showWeaponIcon": true,
            "x": 0,
            "y": -90,
            "scale": 1
          },
          "stats": {
            //Whether to show the simple SPECIAL widget. [Available values: true/false]
            "enabled": true,
            // Whether to show icons vertically or hortizonally [Available values: true/false, default: false]
            "vertical": false,
            "showDiffs": true,
            "x": -10,
            "y": -150
          },
          // Monitor up to 5 items.
          // Pattern accepts a valid text pattern.
          // Label is a text displayed on the screen
          // valuecolor, labelcolor are optional. they sets a color on counter and label fields
          // =============================================================================================================================================================================================================== //
          // No more regex rules, use "search" instead. It allows you to search for items by name, type, or both. You can use multiple search rules for each item.
          // =============================================================================================================================================================================================================== //
          "itemmonitor": {
            "enabled": true,
            "inline": true,
            "x": -30,
            "y": -15,
            "scale": 1,
            "valueprefix": "",
            // Combining any and all rules allows you to create complex search queries. For example, you can search for items that have a specific name and are of a specific type, or items that have a specific name or are of a specific type.
            "items": [
              // This example matches Stimpaks.
              // All rules set there are for  English only
              // Make your own rules for your language, or ask me to add some presets for your language. I can add presets for popular items in different languages, but I won't be able to add them for every language, so you might have to create your own rules. 
              // If you need help with that, contact me on Nexus Mods or Discord.
              {
                "enabled": true,
                // This example matches regular Stimpaks ONLY. 
                "search": {
                  // Search for items that match all of the following rules. If you want to match items that match any of the rules, use "any" instead.
                  "all": ["Stimpak"],
                  // Search for items that match any of the following rules. If you want to match items that match all of the rules, use "all" instead.
                  "any": [],
                  // This will exclude items that match any of the following rules. 
                  "none": []
                },
                "label": "Stimpaks",
                "valuecolor": "#66ACB7",
                "labelcolor": "#FFFFCA"
              },
              // This matches super stimpkas only
              {
                "enabled": true,
                "search": {
                  // Search for items that match all of the following rules. If you want to match items that match any of the rules, use "any" instead.
                  "all": ["Nuclear Keycard"],
                  // Search for items that match any of the following rules. If you want to match items that match all of the rules, use "all" instead.
                  "any": [],
                  // This will exclude items that match any of the following rules. 
                  "none": []
