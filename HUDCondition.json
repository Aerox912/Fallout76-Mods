		{"belowPercent": 5, "color": "0xff0000"},
		{"belowPercent": 20, "color": "0xe8460c"},
		{"belowPercent": 35, "color": "0xffffca"},
		{"belowPercent": 100, "color": "0xffffca"},
		{"belowPercent": 160, "color": "0xffffca"},
		{"belowPercent": 300, "color": "0xffffca"}
