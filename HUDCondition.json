	"alpha": 1.0,
	"blendMode": "normal",
	"textBlendMode": "normal",
	
	"disableRealTimeEdit": false,
	"instantConfigReload": true, // 1 second refresh
	
	
	// CONDITIONS DISPLAY SETTINGS
	"refresh": 100,
	
	"textsScale": {"x": 1.0, "y": 1.0},
	"imagesScale": {"x": 1.0, "y": 1.0},
	
	"percentDecimals": 0,
	
	"useTextColorGradients": true,
